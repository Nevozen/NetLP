generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  strategies    Strategy[]
  settings      Preference?
  revisions     EventRevision[]
  walletWatches WalletWatch[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Preference {
  userId       String @id
  timezone     String @default("Asia/Jakarta")
  theme        String @default("system")
  denomination String @default("USD")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WalletSource {
  ALCHEMY
  CSV
  HASH
}

enum WalletStatus {
  DETECTED
  CONFIRMING
  READY
  NEEDS_REVIEW
  ACTIVITY_ONLY
  POSTED
  UNRELATED
}

model WalletWatch {
  ownerId      String
  chainId      String
  address      String
  generation   Int              @default(1)
  enabled      Boolean          @default(true)
  recent       Boolean
  startBlock   BigInt?
  nextBlock    BigInt?
  cursor       Json?
  lease        String?          @db.Uuid
  leaseUntil   DateTime?        @db.Timestamptz(3)
  nextSyncAt   DateTime?        @db.Timestamptz(3)
  lastSyncedAt DateTime?        @db.Timestamptz(3)
  issue        String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  activities   WalletActivity[]

  @@id([ownerId, chainId])
}

model WalletActivity {
  id               String         @id @default(uuid()) @db.Uuid
  ownerId          String
  chainId          String
  address          String
  txHash           String
  sources          WalletSource[]
  status           WalletStatus   @default(DETECTED)
  ignored          Boolean        @default(false)
  revision         Int            @default(0)
  blockNumber      BigInt?
  blockHash        String?
  txIndex          Int?
  occurredAt       DateTime?      @db.Timestamptz(3)
  topLevel         Boolean        @default(false)
  hasTokens        Boolean        @default(false)
  hasNfts          Boolean        @default(false)
  evidence         Json?
  draft            Json?
  retryAt          DateTime?      @db.Timestamptz(3)
  attempts         Int            @default(0)
  postedStrategyId String?        @db.Uuid
  postedEventIds   String[]       @default([]) @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  watch            WalletWatch    @relation(fields: [ownerId, chainId], references: [ownerId, chainId], onDelete: Restrict)

  @@unique([ownerId, chainId, address, txHash])
  @@index([ownerId, chainId, address, status, retryAt])
  @@index([ownerId, chainId, address, occurredAt(sort: Desc), id])
}

model Strategy {
  id            String               @id @db.Uuid
  requestDigest String               @db.Char(64)
  ownerId       String
  chainId       String
  market        Json
  name          String
  protocol      String
  notes         String?
  walletAddress String?
  positionRef   String?
  openedAt      DateTime             @db.Timestamptz(3)
  closedAt      DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  owner         User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  events        JournalEvent[]
  quotes        PriceSet[]
  drafts        JournalDraft[]
  final         FinalEvaluation?
  walletReviews WalletImportReview[]

  @@unique([id, ownerId, chainId])
  @@index([ownerId, closedAt, openedAt])
}

model JournalEvent {
  id            String          @id @db.Uuid
  strategyId    String          @db.Uuid
  ownerId       String
  chainId       String
  kind          String
  occurredAt    DateTime        @db.Timestamptz(3)
  sequence      Int
  txHash        String?
  actionIndex   Int?
  hasNetworkFee Boolean
  walletOrigin  Json?
  strategy      Strategy        @relation(fields: [strategyId, ownerId, chainId], references: [id, ownerId, chainId], onDelete: Restrict)
  revisions     EventRevision[]

  @@unique([strategyId, id])
  @@unique([strategyId, sequence])
  @@unique([ownerId, chainId, txHash, actionIndex])
  @@index([strategyId, occurredAt, sequence])
}

model WalletImportReview {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String
  chainId    String
  strategyId String    @db.Uuid
  data       Json?
  expiresAt  DateTime  @db.Timestamptz(3)
  postedAt   DateTime? @db.Timestamptz(3)
  strategy   Strategy  @relation(fields: [strategyId, ownerId, chainId], references: [id, ownerId, chainId], onDelete: Restrict)

  @@index([ownerId, expiresAt])
}

model EventRevision {
  id         String       @id @db.Uuid
  strategyId String       @db.Uuid
  eventId    String       @db.Uuid
  version    Int
  digest     String       @db.Char(64)
  occurredAt DateTime     @db.Timestamptz(3)
  facts      Json
  format     Int          @default(1)
  priceSetId String       @db.Uuid
  reason     String?
  actorId    String
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  event      JournalEvent @relation(fields: [strategyId, eventId], references: [strategyId, id], onDelete: Restrict)
  prices     PriceSet     @relation(fields: [strategyId, priceSetId], references: [strategyId, id], onDelete: Restrict)
  actor      User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([eventId, version])
}

enum PricePurpose {
  EVENT
  MARK
}

model PriceSet {
  id         String           @id @default(uuid()) @db.Uuid
  strategyId String           @db.Uuid
  at         DateTime         @db.Timestamptz(3)
  purpose    PricePurpose
  quotes     Json
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  strategy   Strategy         @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  revisions  EventRevision[]
  final      FinalEvaluation?

  @@unique([strategyId, id])
  @@index([strategyId, purpose, at(sort: Desc), createdAt(sort: Desc)])
}

model JournalDraft {
  id         String   @id @db.Uuid
  strategyId String   @db.Uuid
  fields     Json
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  @@index([strategyId, updatedAt])
}

model FinalEvaluation {
  strategyId  String   @id @db.Uuid
  at          DateTime @db.Timestamptz(3)
  version     String
  priceSetId  String   @db.Uuid
  revisionIds Json
  results     Json
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  prices      PriceSet @relation(fields: [strategyId, priceSetId], references: [strategyId, id], onDelete: Restrict)

  @@unique([strategyId, priceSetId])
}
